[Unit]
Description=Appliance privileged administration daemon
After=network.target NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/appliance-admin/daemon.env
ExecStart=/opt/appliance-admin/venv/bin/appliance-admin-daemon
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=appliance-admin
RuntimeDirectoryMode=0750

# Root is required for NetworkManager/systemd control, so hardening avoids capabilities
# that would break those operations while still shrinking the process environment.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/run/appliance-admin /etc/NetworkManager/system-connections

[Install]
WantedBy=multi-user.target
