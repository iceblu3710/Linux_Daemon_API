APPLIANCE_ADMIN_SOCKET_PATH=/run/appliance-admin/admin.sock
APPLIANCE_ADMIN_SOCKET_GROUP=appliance-web
APPLIANCE_ADMIN_ALLOWED_SERVICES='["ninja-timer.service","nginx.service"]'
APPLIANCE_ADMIN_SCAN_MIN_INTERVAL_SECONDS=12
APPLIANCE_ADMIN_SCAN_CACHE_SECONDS=8
APPLIANCE_ADMIN_WIFI_INTERFACE=wlp1s0
APPLIANCE_ADMIN_NETWORK_CHECKPOINT_TIMEOUT_SECONDS=45
APPLIANCE_ADMIN_NETWORK_ACTIVATION_TIMEOUT_SECONDS=25
APPLIANCE_ADMIN_REQUEST_TIMEOUT_SECONDS=30
APPLIANCE_ADMIN_LOG_LEVEL=INFO
