APPLIANCE_WEB_DAEMON_SOCKET=/run/appliance-admin/admin.sock
APPLIANCE_WEB_BIND_HOST=127.0.0.1
APPLIANCE_WEB_BIND_PORT=8088
APPLIANCE_WEB_TRUSTED_PROXY_HEADERS=false
APPLIANCE_WEB_AUTH_SECRET=replace-with-at-least-32-random-characters
APPLIANCE_WEB_AUTH_ISSUER=appliance-admin
APPLIANCE_WEB_AUTH_AUDIENCE=appliance-admin-api
APPLIANCE_WEB_LOG_LEVEL=INFO
